{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lulicv.local/schema/resume-data-v1.json",
  "title": "LuliCV ResumeData v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "basics", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "basics": { "$ref": "#/$defs/basics" },
    "sections": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/summarySection" },
          { "$ref": "#/$defs/experienceSection" },
          { "$ref": "#/$defs/projectsSection" },
          { "$ref": "#/$defs/educationSection" },
          { "$ref": "#/$defs/skillsSection" },
          { "$ref": "#/$defs/customSection" }
        ]
      }
    }
  },
  "$defs": {
    "nonEmptyId": { "type": "string", "pattern": "\\S", "description": "Not blank" },
    "contactUrl": {
      "type": "string",
      "description": "At most 500 characters, or one {{private:…}} placeholder",
      "anyOf": [{ "maxLength": 500 }, { "pattern": "^\\{\\{private:[^{}]*\\}\\}$" }]
    },
    "detailText": {
      "type": "string",
      "description": "At most 20 characters, or one {{private:…}} placeholder",
      "anyOf": [{ "maxLength": 20 }, { "pattern": "^\\{\\{private:[^{}]*\\}\\}$" }]
    },
    "inlineText": {
      "type": "string",
      "description": "Plain text with optional **bold emphasis** markers; HTML is not interpreted. In a summary, description, additional or bullet, a newline starts a new line"
    },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/inlineText" } },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageBreakBefore"],
      "properties": {
        "pageBreakBefore": { "type": "boolean" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "label": {
          "type": "string",
          "maxLength": 30,
          "description": "A category such as GitHub, or the content itself such as an account name"
        },
        "url": { "$ref": "#/$defs/contactUrl", "description": "May be empty when show prints the label" },
        "show": {
          "enum": ["url", "label", "both"],
          "description": "What the header prints: the address (default when absent), the label, or the label followed by the address. Use label for an account name whose address is long or unreadable"
        },
        "icon": {
          "enum": [
            "none",
            "link",
            "globe",
            "xiaohongshu",
            "douyin",
            "bilibili",
            "weibo",
            "zhihu",
            "wechat",
            "github",
            "linkedin"
          ],
          "description": "The mark before the link, where the theme shows icons. Absent: chosen from the address's site, else a platform the label names, else globe for 个人网站 and link otherwise. Leave it out unless the user picks one, or the address is a short link whose platform cannot be told from it"
        }
      }
    },
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "headline", "phone", "email", "location", "links"],
      "properties": {
        "name": { "type": "string" },
        "headline": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "links": {
          "type": "array",
          "maxItems": 3,
          "description": "Links such as a personal site, GitHub or a portfolio, at most 3",
          "items": { "$ref": "#/$defs/link" }
        },
        "photo": { "type": "string", "description": "Optional local image data URL" },
        "gender": {
          "$ref": "#/$defs/detailText",
          "description": "Optional, e.g. 男 or 女; leave the key out when not given"
        },
        "birthDate": { "$ref": "#/$defs/detailText", "description": "Optional year and month of birth, e.g. 2000.05" },
        "politicalStatus": {
          "$ref": "#/$defs/detailText",
          "description": "Optional political status, e.g. 群众, 共青团员 or 中共党员"
        },
        "hometown": {
          "$ref": "#/$defs/detailText",
          "description": "Optional native place (籍贯), e.g. 上海; not where the person lives now"
        },
        "yearsOfExperience": {
          "$ref": "#/$defs/detailText",
          "description": "Optional years of work experience as written, e.g. 3 年"
        }
      }
    },
    "experienceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "company", "role", "location", "startDate", "endDate", "description", "bullets"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "company": { "type": "string" },
        "role": { "type": "string" },
        "location": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "description": { "$ref": "#/$defs/inlineText" },
        "bullets": { "$ref": "#/$defs/stringArray" }
      }
    },
    "projectEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "subtitle", "date", "link", "description", "bullets"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "date": { "type": "string" },
        "link": { "type": "string" },
        "description": { "$ref": "#/$defs/inlineText" },
        "bullets": { "$ref": "#/$defs/stringArray" }
      }
    },
    "educationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "school", "degree", "major", "date", "additional", "bullets"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "school": { "type": "string" },
        "degree": { "type": "string" },
        "major": { "type": "string" },
        "date": { "type": "string" },
        "additional": { "$ref": "#/$defs/inlineText" },
        "bullets": { "$ref": "#/$defs/stringArray" }
      }
    },
    "skillEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "category": { "type": "string" },
        "items": { "$ref": "#/$defs/stringArray" }
      }
    },
    "customEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "subtitle", "date", "link", "description", "bullets"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "date": { "type": "string" },
        "link": { "type": "string" },
        "description": { "$ref": "#/$defs/inlineText" },
        "bullets": { "$ref": "#/$defs/stringArray" }
      }
    },
    "summarySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "visible", "layout", "text", "entries"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "type": { "const": "summary" },
        "title": { "type": "string" },
        "visible": { "type": "boolean" },
        "layout": { "$ref": "#/$defs/layout" },
        "text": { "$ref": "#/$defs/inlineText" },
        "entries": { "type": "array", "maxItems": 0 }
      }
    },
    "experienceSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "visible", "layout", "entries"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "type": { "const": "experience" },
        "title": { "type": "string" },
        "visible": { "type": "boolean" },
        "layout": { "$ref": "#/$defs/layout" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/experienceEntry" } }
      }
    },
    "projectsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "visible", "layout", "entries"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "type": { "const": "projects" },
        "title": { "type": "string" },
        "visible": { "type": "boolean" },
        "layout": { "$ref": "#/$defs/layout" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/projectEntry" } }
      }
    },
    "educationSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "visible", "layout", "entries"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "type": { "const": "education" },
        "title": { "type": "string" },
        "visible": { "type": "boolean" },
        "layout": { "$ref": "#/$defs/layout" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/educationEntry" } }
      }
    },
    "skillsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "visible", "layout", "entries"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "type": { "const": "skills" },
        "title": { "type": "string" },
        "visible": { "type": "boolean" },
        "layout": { "$ref": "#/$defs/layout" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/skillEntry" } }
      }
    },
    "customSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "visible", "layout", "entries"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyId" },
        "type": { "const": "custom" },
        "title": { "type": "string" },
        "visible": { "type": "boolean" },
        "layout": { "$ref": "#/$defs/layout" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/customEntry" } }
      }
    }
  }
}
